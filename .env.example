# ==============================================================================
#  jobstrackr-new — ENVIRONMENT TEMPLATE
# ==============================================================================
#  THIS FILE IS COMMITTED TO GIT. It must never contain a real value.
#  Copy it to .env.local and fill that in instead — .env.local is gitignored.
#
#  [PUBLIC] keys are inlined into the browser bundle. That is expected and safe.
#  [SECRET] keys must stay server-side. If one leaks, rotate it in the Supabase
#  dashboard immediately — rotating is cheap, a leaked secret key is not.
#
#  Every non-empty key here must also be set in
#  Vercel → Project → Settings → Environment Variables (Production + Preview).
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. SUPABASE
# ------------------------------------------------------------------------------
#  Project ref: <your 20-char project ref>
#
#  Supabase now issues two key formats. We use the NEW one throughout —
#  `sb_publishable_…` / `sb_secret_…` — because the legacy anon / service_role
#  JWTs are on Supabase's deprecation path. The legacy pair you supplied is kept
#  at the bottom of this file, unread by the app, in case anything needs it.
# ------------------------------------------------------------------------------

# [PUBLIC] Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# [PUBLIC] Settings → API Keys → Publishable key. Respects Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# [SECRET] Settings → API Keys → Secret key. BYPASSES Row Level Security.
#          Server-side only, and only where a request genuinely must escape RLS.
SUPABASE_SECRET_KEY=

# [SECRET] The 20-char project ref — the subdomain of the URL above.
SUPABASE_PROJECT_REF=

# [SECRET] Database password, chosen when the project was created.
#          Used by the Supabase CLI (`supabase db push`), not by the running app.
#          STILL NEEDED — Module 1 cannot push migrations without it.
#          Settings → Database → Reset database password, if it was never saved.
SUPABASE_DB_PASSWORD=

# [SECRET] CLI personal access token, so migrations push without interactive login.
#          https://supabase.com/dashboard/account/tokens
#          Optional — `supabase login` works instead.
SUPABASE_ACCESS_TOKEN=


# ------------------------------------------------------------------------------
# 2. APPLICATION
# ------------------------------------------------------------------------------

# [PUBLIC] Canonical origin. Drives canonical URLs, sitemap, OG tags and auth
#          redirects. localhost here; the real domain is set in Vercel.
NEXT_PUBLIC_SITE_URL=


# ------------------------------------------------------------------------------
# 3. CACHE INVALIDATION
# ------------------------------------------------------------------------------
# Pages are rendered once and served from the CDN until ingestion says the data
# changed. These secrets authenticate that signal — anyone holding one can force
# unlimited re-renders, so they are generated, not chosen.
#
# Generated with `openssl rand -hex 32`. Regenerate with the same command.
# ------------------------------------------------------------------------------

REVALIDATE_SECRET=
CRON_SECRET=


# ------------------------------------------------------------------------------
# 4. INGESTION  (Module 11)
# ------------------------------------------------------------------------------

# [SECRET] Deployed Apps Script web-app /exec URL serving the sheet feed.
APPS_SCRIPT_WEBAPP_URL=

# [SECRET] Shared secret between that web app and the sync endpoint.
SHEETS_SYNC_SECRET=


# ------------------------------------------------------------------------------
# 5. RATE LIMITING  (Module 12)
# ------------------------------------------------------------------------------
# Upstash is kept ONLY for rate limiting write endpoints. It is deliberately not
# a data cache any more — the CDN does that job, for free, and better.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ------------------------------------------------------------------------------
# 6. LLM PROVIDERS  (Modules 8, 11 and 19)
# ------------------------------------------------------------------------------
# The numbered Groq keys are a rotation pool carried over from the old scraper —
# it spread rate limits across free-tier accounts. Module 11 decides whether that
# is still needed or whether one key with proper backoff is enough.
#
# Gemini drives the tracker's exam-status refresh (Module 19). All three keys
# below are OPTIONAL: without them the app boots, serves every page, and the
# refresh button reports that the feature is not configured. That is deliberate —
# one panel should not be able to stop a deploy.
#
# THE POOL LIVES IN THE DATABASE, NOT HERE. `public.api_keys_config` holds the
# rotation pool — ten free-tier keys, tried in priority order, each rotated past
# on a 429 and disabled outright on an invalid-key 400. Rows there win over
# everything below; the environment is the fallback for a deployment with an
# empty table. Load keys with a plain INSERT of the plaintext value — a trigger
# encrypts them, and the app reads them back through
# `decrypted_api_keys_config`. See migration 0024.
#
# [SECRET] https://aistudio.google.com/apikey. The key must have the Generative
#          Language API enabled, and must be on a tier that carries the
#          `google_search` grounding tool — grounding is the whole feature, and
#          an answer written from model memory about this week's admit card is
#          worse than no answer.
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=

# [SECRET] The numbered fallback pool, as the old project named it. Read in
#          order after GEMINI_API_KEY. Note what an environment pool cannot do:
#          nothing here survives the request, so a key that just returned 429 is
#          walked into again by the very next one. Prefer api_keys_config.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=

# [SECRET] The same pool as one variable, comma-separated. Read last.
GEMINI_API_KEYS=

# Model name. Defaults to gemini-2.5-flash when unset. Overridable because model
# names age faster than anything else here, and a rename should be an
# environment change rather than a deploy — but whatever is named must support
# Google Search grounding.
GEMINI_MODEL=


# ------------------------------------------------------------------------------
# 7. TELEGRAM  (Module 9)
# ------------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=


# ------------------------------------------------------------------------------
# 7b. PUSH INDEXING  (optional — the SEO worker)
# ------------------------------------------------------------------------------
#  All three are optional. Absent, the worker reports the target as switched
#  off and does nothing; the site's sitemap, structured data and robots rules
#  work regardless. That is deliberate: a preview deployment or a fork must not
#  be able to announce URLs on the production domain's behalf.
#
#  Full setup, including the Search Console step people skip, is in docs/SEO.md.
# ------------------------------------------------------------------------------

# [PUBLIC] IndexNow key — `openssl rand -hex 16`. Not a secret: the protocol
#  works by serving it back publicly from /<key>.txt to prove host ownership.
#  It lives here rather than in public/ so rotating it is a dashboard edit.
#  16-128 chars of [a-zA-Z0-9-]; the 16 floor keeps the root /:key.txt rewrite
#  from shadowing conventional files like security.txt.
INDEXNOW_KEY=

# [PUBLIC] The `client_email` from a Google Cloud service account JSON key,
#  with the Indexing API enabled and the account added as an OWNER of the
#  Search Console property. Without the ownership step every submission is 403.
GOOGLE_INDEXING_CLIENT_EMAIL=

# [SECRET] The `private_key` from the same JSON, pasted whole. The escaped \n
#  sequences a dashboard produces are expected and handled.
GOOGLE_INDEXING_PRIVATE_KEY=


# ------------------------------------------------------------------------------
# 8. MONITORING  (Module 12) — create the Sentry project when we get there
# ------------------------------------------------------------------------------

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=


# ------------------------------------------------------------------------------
# 9. TRANSACTIONAL EMAIL — read by the Supabase CLI, not by the app
# ------------------------------------------------------------------------------
# [SECRET] Resend API key, used as the SMTP password in
#          `supabase/config.toml` → [auth.email.smtp]. That is the *only* thing
#          that reads it: it is deliberately absent from `serverSchema` in
#          `src/lib/env.ts`, because the Next app never sends mail itself and a
#          key it does not use has no business being validated at boot.
#
#          It still belongs in this file. Without it `supabase start` comes up
#          with SMTP enabled and no password, so sign-up and password-reset
#          emails fail locally — with nothing in the app to explain why.
#
#          Read the comment above `[auth.email.smtp]` in `supabase/config.toml`
#          before setting it: with this key present, a dev machine sends real
#          mail to real addresses and spends the production quota.
RESEND_API_KEY=


# ------------------------------------------------------------------------------
# 10. LEGACY — supplied, but NOT read by the app
# ------------------------------------------------------------------------------
# The old-format Supabase JWTs, kept only so nothing is lost if a third-party
# tool still expects them. The app uses the publishable/secret pair above.
# Delete this block once you are sure nothing needs it.






# ------------------------------------------------------------------------------
# 5. GOOGLE SIGN-IN  (optional)
# ------------------------------------------------------------------------------
#  Leave both blank and Google sign-in stays off. The app asks the auth server
#  which providers are enabled, so the "Continue with Google" button is hidden
#  rather than shown-and-broken — no flag here needs to agree with reality.
#
#  These are read by the Supabase CLI for LOCAL development, via
#  supabase/config.toml. In production the same pair is entered in
#  Supabase → Authentication → Providers instead, not here.
#
#  Get them from Google Cloud Console → Credentials → OAuth client ID (Web),
#  with this exact authorised redirect URI for local use:
#    http://127.0.0.1:54421/auth/v1/callback
#  Then set `enabled = true` under [auth.external.google] in config.toml and
#  restart: supabase stop && supabase start
# ------------------------------------------------------------------------------

# [SECRET] Google OAuth client ID.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=

# [SECRET] Google OAuth client secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# [PUBLIC] The same Google OAuth client ID, exposed to the browser.
#          This is what stops the consent screen reading
#          "to continue to <project-ref>.supabase.co": with it set, the page
#          asks Google for an ID token itself instead of being redirected
#          through Supabase's auth server, so Google labels the account chooser
#          with this origin's app name. A client ID is not a credential.
#
#          Requires the origin to be listed under "Authorised JavaScript
#          origins" on the same OAuth client — a different list from the
#          redirect URIs above. See docs/GOOGLE-SIGN-IN.md.
#
#          Optional. Unset, the Google button falls back to the redirect flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# ------------------------------------------------------------------------------
# 6. OLD PROJECT  (optional, one-off imports)
# ------------------------------------------------------------------------------
#  Read-only access to the Supabase project the old app ran on. Nothing at
#  runtime touches these — they are for the scripts in `scripts/` that move
#  content across, and `scripts/import-legacy-logos.mjs` is the one that needs
#  them today (it reads the `logos` storage bucket).
#
#  Leave blank unless you are running one of those scripts.
# ------------------------------------------------------------------------------

# [PUBLIC] The old project's URL.
LEGACY_SUPABASE_URL=

# [SECRET] Its service-role key. Storage listing needs one; the anon key cannot
#  enumerate a bucket.
LEGACY_SUPABASE_SERVICE_KEY=
